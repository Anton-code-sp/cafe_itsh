# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env al repositorio.

DATABASE_URL=postgresql://usuario:password@localhost:5432/cafe
JWT_SECRET=reemplaza-con-un-segredo-largo-y-aleatorio
PAYMENT_API_KEY=placeholder-por-definir
NOTIFICATION_API_KEY=placeholder-por-definir
NODE_ENV=development
PORT=3001
SEED_ADMIN_PASSWORD=cambia-estas-contrasenas
SEED_CAJERO_PASSWORD=cambia-estas-contrasenas
SEED_COCINERO_PASSWORD=cambia-estas-contrasenas
# Vacío = acepta cualquier correo (solo desarrollo)
ALLOWED_EMAIL_DOMAINS=itsx.mx,its.edu.mx

# Hora de corte de pedidos anticipados (HH:MM) y zona horaria del servidor
CUTOFF_TIME=13:00
TZ=America/Mexico_City
NOTIFY_CHANNEL=console
